{
  "name": "meme-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner-friendly Solana meme-coin trading bot. Checkpoint 08 adds a read-only historical backtester for frozen s07_v1 — blockchain writes and trading are not implemented.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "solana:check": "tsx src/solana/check.ts",
    "market:check": "tsx src/market-data/check.ts",
    "market:watch": "tsx src/market-data/watch.ts",
    "discovery:check": "tsx src/discovery/check.ts",
    "discovery:watch": "tsx src/discovery/watch.ts",
    "db:init": "tsx src/persistence/commands/init.ts",
    "db:status": "tsx src/persistence/commands/status.ts",
    "db:history": "tsx src/persistence/commands/history.ts",
    "collect:once": "tsx src/collector/once.ts",
    "collect:watch": "tsx src/collector/watch.ts",
    "risk:check": "tsx src/risk/check.ts",
    "risk:record": "tsx src/risk/record.ts",
    "risk:history": "tsx src/risk/history.ts",
    "feature:check": "tsx src/features/check.ts",
    "feature:record": "tsx src/features/record.ts",
    "feature:history": "tsx src/features/history.ts",
    "strategy:check": "tsx src/strategy/check.ts",
    "strategy:record": "tsx src/strategy/record.ts",
    "strategy:history": "tsx src/strategy/history.ts",
    "backtest:run": "tsx src/backtest/run.ts"
  },
  "dependencies": {
    "@solana/kit": "^7.1.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
