NODE_ENV=development
LOG_LEVEL=info
TRADING_ENABLED=false

# Official public Solana RPC. Fine for development/testing, not for production trading.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_TIMEOUT_MS=10000

# Manual watchlist only. Use mint addresses, not ticker symbols.
# Wrapped SOL and USDC are included for development observation.
MARKET_DATA_TOKEN_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MARKET_DATA_TIMEOUT_MS=10000
MARKET_DATA_POLL_INTERVAL_MS=15000

# Read-only discovery. This does not enable trading.
DISCOVERY_ENABLED=true
DISCOVERY_INCLUDE_PROFILES=true
DISCOVERY_INCLUDE_BOOSTS=true
DISCOVERY_TIMEOUT_MS=10000
DISCOVERY_POLL_INTERVAL_MS=30000
DISCOVERY_MAX_CANDIDATES=20
DISCOVERY_ENRICH_MARKET_DATA=true

# Local SQLite persistence. This does not enable trading or blockchain writes.
DATABASE_ENABLED=true
DATABASE_PATH=./data/soltradingbot.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000

# Read-only token risk scanner. Uses SOLANA_RPC_URL. This does not enable trading.
RISK_SCAN_TIMEOUT_MS=10000
RISK_SCAN_COMMITMENT=confirmed
RISK_HISTORY_LIMIT=20

# Feature history display bound. Feature-set version is code, not an env setting.
FEATURE_HISTORY_LIMIT=20

# Strategy history display bound. Strategy version and thresholds are code, not env settings.
STRATEGY_HISTORY_LIMIT=20

# Paper history display bound. Paper spec, prices, and models are code, not env settings.
PAPER_HISTORY_LIMIT=20

# Position history display bound. Position spec, notional, and quantity formula are code, not env settings.
POSITION_HISTORY_LIMIT=20
