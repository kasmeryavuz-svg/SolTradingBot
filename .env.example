NODE_ENV=development
LOG_LEVEL=info
TRADING_ENABLED=false
LIVE_BROADCAST_ENABLED=false

# Official public Solana RPC. Fine for development/testing, not for production trading.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_TIMEOUT_MS=10000

# Manual watchlist only. Use mint addresses, not ticker symbols.
# Wrapped SOL and USDC are included for development observation.
MARKET_DATA_TOKEN_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MARKET_DATA_TIMEOUT_MS=10000
MARKET_DATA_POLL_INTERVAL_MS=15000

# Read-only discovery. This does not enable trading.
DISCOVERY_ENABLED=true
DISCOVERY_INCLUDE_PROFILES=true
DISCOVERY_INCLUDE_BOOSTS=true
DISCOVERY_TIMEOUT_MS=10000
DISCOVERY_POLL_INTERVAL_MS=30000
DISCOVERY_MAX_CANDIDATES=20
DISCOVERY_ENRICH_MARKET_DATA=true

# Local SQLite persistence. This does not enable trading or blockchain writes.
DATABASE_ENABLED=true
DATABASE_PATH=./data/soltradingbot.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000

# Read-only token risk scanner. Uses SOLANA_RPC_URL. This does not enable trading.
RISK_SCAN_TIMEOUT_MS=10000
RISK_SCAN_COMMITMENT=confirmed
RISK_HISTORY_LIMIT=20

# Feature history display bound. Feature-set version is code, not an env setting.
FEATURE_HISTORY_LIMIT=20

# Strategy history display bound. Strategy version and thresholds are code, not env settings.
STRATEGY_HISTORY_LIMIT=20

# Paper history display bound. Paper spec, prices, and models are code, not env settings.
PAPER_HISTORY_LIMIT=20

# Position history display bound. Position spec, notional, and quantity formula are code, not env settings.
POSITION_HISTORY_LIMIT=20

# Exit history display bound. Exit spec, stop, take-profit, and max hold are code, not env settings.
EXIT_HISTORY_LIMIT=20

# Performance trade list display bound. Metric formulas are code, not env settings.
# This does not change performance:report, which always uses every eligible closed trade.
PERFORMANCE_TRADE_LIMIT=20

# Research trade list display bound. Candidate rules and research metrics are code, not env settings.
# This does not change research:compare, which always uses the full r125 research universe.
RESEARCH_TRADE_LIMIT=20

# Local loopback-only observability dashboard. Host is code-defined as 127.0.0.1.
# This does not enable trading, wallets, or execution.
DASHBOARD_PORT=4313

# Checkpoint 14/15 public-only execution identity. There is no default wallet, token, or amount.
# amountRaw is the input token's smallest native unit, for example 1000000.
# EXECUTION_TAKER_PUBKEY is the public trading address.
# CP15 deliberately does not accept private keys from .env.
# Secret input is interactive TTY only.
# EXECUTION_TAKER_PUBKEY=
# EXECUTION_INPUT_MINT=
# EXECUTION_OUTPUT_MINT=
# EXECUTION_AMOUNT_RAW=
# l16_v1 live:execute also requires LIVE_BROADCAST_ENABLED=true, TTY confirmation,
# and the hidden wallet prompt. Hard caps are code-defined. There is no LIVE_PAIR
# or LIVE_AMOUNT_CAP override. Default is false. Never default true.
# LIVE_BROADCAST_ENABLED=false
EXECUTION_PROVIDER_TIMEOUT_MS=5000
# Optional Jupiter API key for the x-api-key header. Never commit a real key. Never printed.
# JUPITER_API_KEY=

# Checkpoint 18 public wallet-intelligence RPC. Placeholder only. Never commit a real key.
# Put the key here, not inside a URL. Never printed. Not stored in SQLite.
# HELIUS_API_KEY=

# Checkpoint 20 paper-only production supervisor. See .env.production.example.
# prod:run requires PROD20_ENABLED=true. Do not enable live flags.
# PROD20_ENABLED=false
# PROD20_INTERVAL_MS=300000
# PROD20_COLLECTOR_ENABLED=true
# PROD20_PAPER_ENABLED=false
# PROD20_PAPER_MINTS=
# PROD20_HEALTH_PORT=4314
